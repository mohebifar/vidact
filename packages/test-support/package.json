{
  "name": "@vidact/test-support",
  "version": "0.2.0-beta.0",
  "description": "Testing helpers for compiled Vidact applications",
  "keywords": [
    "react",
    "testing",
    "vidact",
    "vitest"
  ],
  "homepage": "https://github.com/mohebifar/vidact#readme",
  "bugs": "https://github.com/mohebifar/vidact/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohebifar/vidact.git",
    "directory": "packages/test-support"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-typescript-package.mjs dist && tsc -p tsconfig.build.json && node ../../scripts/finalize-typescript-package.mjs dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@vidact/runtime": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@vidact/runtime": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
