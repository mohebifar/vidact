{
  "name": "@vidact/runtime",
  "version": "0.2.0-beta.4",
  "description": "Fine-grained direct-DOM runtime for compiled Vidact applications",
  "keywords": [
    "compiler",
    "dom",
    "react",
    "runtime",
    "vidact"
  ],
  "homepage": "https://github.com/mohebifar/vidact#readme",
  "bugs": "https://github.com/mohebifar/vidact/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohebifar/vidact.git",
    "directory": "packages/runtime"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*hydrate.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./concurrent": {
      "types": "./dist/concurrent.d.ts",
      "import": "./dist/concurrent.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.js"
    },
    "./dom/forms": {
      "types": "./dist/dom-forms.d.ts",
      "import": "./dist/dom-forms.js"
    },
    "./dom/namespace": {
      "types": "./dist/dom/namespace.d.ts",
      "import": "./dist/dom/namespace.js"
    },
    "./dom/styles": {
      "types": "./dist/dom-styles.d.ts",
      "import": "./dist/dom-styles.js"
    },
    "./retained-ui": {
      "types": "./dist/retained-ui.d.ts",
      "import": "./dist/retained-ui.js"
    },
    "./profiling": {
      "types": "./dist/profiling.d.ts",
      "import": "./dist/profiling.js"
    },
    "./framework": {
      "types": "./dist/framework.d.ts",
      "import": "./dist/framework.js"
    },
    "./framework/hydrate": {
      "types": "./dist/framework-hydrate.d.ts",
      "import": "./dist/framework-hydrate.js"
    },
    "./framework/protocol": {
      "types": "./dist/framework-protocol.d.ts",
      "import": "./dist/framework-protocol.js"
    },
    "./framework/server": {
      "types": "./dist/server-framework.d.ts",
      "import": "./dist/server-framework.js"
    },
    "./framework/server/jsx-dev-runtime": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./framework/server/jsx-runtime": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./hydrate/jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./hydrate/jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/jsx-dev-runtime": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/jsx-runtime": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run && vitest run --config vitest.retained-ui.config.ts && vitest run --config vitest.server.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@vidact/react-types": "workspace:*",
    "@vidact/test-support": "workspace:*",
    "@vitest/browser-playwright": "4.1.11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@types/react": "^19.2.18"
  },
  "engines": {
    "node": ">=24"
  }
}
