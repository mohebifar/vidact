{
  "name": "@vidact/vite",
  "version": "0.2.0-beta.2",
  "description": "Vite integration for the Vidact React-to-Vanilla compiler",
  "keywords": [
    "compiler",
    "react",
    "tsx",
    "vidact",
    "vite"
  ],
  "homepage": "https://github.com/mohebifar/vidact#readme",
  "bugs": "https://github.com/mohebifar/vidact/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohebifar/vidact.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@vidact/compiler": "workspace:*",
    "@vidact/runtime": "workspace:*",
    "rolldown": "1.2.5"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@types/node": "^24.13.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
