{
  "name": "@vidact/vite",
  "version": "0.0.0",
  "description": "Vite integration for the Vidact React-to-Vanilla compiler",
  "keywords": [
    "compiler",
    "react",
    "tsx",
    "vidact",
    "vite"
  ],
  "homepage": "https://github.com/mohebifar/vidact#readme",
  "bugs": "https://github.com/mohebifar/vidact/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohebifar/vidact.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/finalize-typescript-package.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vidact/compiler": "workspace:*",
    "@vidact/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
