{
  "name": "@vidact/react-types",
  "version": "0.2.0-beta.6",
  "description": "React-shaped JSX and DOM type declarations for Vidact",
  "keywords": [
    "jsx",
    "react",
    "tsx",
    "types",
    "vidact"
  ],
  "homepage": "https://github.com/mohebifar/vidact#readme",
  "bugs": "https://github.com/mohebifar/vidact/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohebifar/vidact.git",
    "directory": "packages/react-types"
  },
  "files": [
    "CHANGELOG.md",
    "index.d.ts",
    "jsx-runtime.d.ts",
    "jsx-runtime.js",
    "react-dom.d.ts",
    "react-dom-server.d.ts",
    "react-dom-static.d.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vidact/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^19.2.18"
  },
  "engines": {
    "node": ">=24"
  }
}
