+//! Owned, pre-codegen analysis snapshots for compiler integrations.
+//!
+//! These types intentionally do not expose the arena-backed React Compiler HIR.
+//! Scope facts are captured immediately before code generation. Def-use facts
+//! are captured just before lvalue pruning, while source binding identities are
+//! still available.
+
+use crate::react_compiler_hir::{
+    BlockKind, GotoVariant, HirFunction, InstructionValue, ReactiveFunction, ReactiveInstruction,
+    ReactiveScopeBlock, ReactiveValue, ReturnVariant, Terminal,
+    environment::Environment,
+    visitors::{each_instruction_value_lvalue, each_instruction_value_operand},
+};
+use crate::react_compiler_reactive_scopes::visitors::{
+    ReactiveFunctionVisitor, visit_reactive_function,
+};
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct FunctionAnalysis {
+    pub name: Option<String>,
+    /// Byte range of the original function in the compiler input.
+    pub span: Option<(u32, u32)>,
+    /// Owned snapshot of the analyzed HIR control-flow graph before it is
+    /// converted into React Compiler's codegen-oriented reactive tree.
+    pub control_flow: ControlFlowAnalysis,
+    /// Render-time writes captured before dead-code elimination can erase
+    /// semantically destructive assignments.
+    pub render_writes: Vec<WriteAnalysis>,
+    pub scopes: Vec<ScopeAnalysis>,
+    pub instructions: Vec<InstructionAnalysis>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ControlFlowAnalysis {
+    pub entry: usize,
+    pub blocks: Vec<BlockAnalysis>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct BlockAnalysis {
+    pub id: usize,
+    pub kind: BlockKindAnalysis,
+    pub instructions: Vec<ControlFlowInstructionAnalysis>,
+    pub terminal: TerminalAnalysis,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum BlockKindAnalysis {
+    Block,
+    Value,
+    Loop,
+    Sequence,
+    Catch,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ControlFlowInstructionAnalysis {
+    pub id: usize,
+    pub kind: InstructionKindAnalysis,
+    pub span: Option<(u32, u32)>,
+    pub lvalues: Vec<ValueAnalysis>,
+    pub dependencies: Vec<ValueAnalysis>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum InstructionKindAnalysis {
+    LoadLocal,
+    LoadContext,
+    DeclareLocal,
+    DeclareContext,
+    StoreLocal,
+    StoreContext,
+    Destructure,
+    Primitive,
+    JsxText,
+    BinaryExpression,
+    NewExpression,
+    CallExpression,
+    MethodCall,
+    UnaryExpression,
+    TypeCastExpression,
+    JsxExpression,
+    ObjectExpression,
+    ObjectMethod,
+    ArrayExpression,
+    JsxFragment,
+    RegExpLiteral,
+    MetaProperty,
+    PropertyStore,
+    PropertyLoad,
+    PropertyDelete,
+    ComputedStore,
+    ComputedLoad,
+    ComputedDelete,
+    LoadGlobal,
+    StoreGlobal,
+    FunctionExpression,
+    TaggedTemplateExpression,
+    TemplateLiteral,
+    Await,
+    GetIterator,
+    IteratorNext,
+    NextPropertyOf,
+    PrefixUpdate,
+    PostfixUpdate,
+    Debugger,
+    StartMemoize,
+    FinishMemoize,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TerminalAnalysis {
+    pub id: usize,
+    pub kind: TerminalKindAnalysis,
+    pub span: Option<(u32, u32)>,
+    /// Value operands in terminal-defined order. For example, a return has one
+    /// value and an if has its test value.
+    pub operands: Vec<ValueAnalysis>,
+    /// Successor block ids in terminal-defined order.
+    pub successors: Vec<usize>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum TerminalKindAnalysis {
+    Unreachable,
+    Throw,
+    Return(ReturnVariantAnalysis),
+    Goto(GotoVariantAnalysis),
+    If,
+    Branch,
+    Switch,
+    DoWhile,
+    While,
+    For,
+    ForOf,
+    ForIn,
+    Logical,
+    Ternary,
+    Optional,
+    Label,
+    Sequence,
+    MaybeThrow,
+    Try,
+    Scope,
+    PrunedScope,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ReturnVariantAnalysis {
+    Void,
+    Implicit,
+    Explicit,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GotoVariantAnalysis {
+    Break,
+    Continue,
+    Try,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ScopeAnalysis {
+    pub dependencies: Vec<DependencyAnalysis>,
+    pub declarations: Vec<String>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DependencyAnalysis {
+    pub name: String,
+    pub path: Vec<String>,
+    pub reactive: bool,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct InstructionAnalysis {
+    pub lvalues: Vec<ValueAnalysis>,
+    pub dependencies: Vec<ValueAnalysis>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ValueAnalysis {
+    pub id: usize,
+    pub declaration_id: usize,
+    pub name: Option<String>,
+    pub span: Option<(u32, u32)>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct WriteAnalysis {
+    pub kind: WriteKindAnalysis,
+    pub span: Option<(u32, u32)>,
+    pub targets: Vec<ValueAnalysis>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum WriteKindAnalysis {
+    Local,
+    Context,
+    Global,
+    Destructure,
+    Property,
+    ComputedProperty,
+    DeleteProperty,
+    DeleteComputedProperty,
+    PrefixUpdate,
+    PostfixUpdate,
+}
+
+pub(crate) fn capture_control_flow(
+    function: &HirFunction<'_>,
+    environment: &Environment<'_>,
+) -> ControlFlowAnalysis {
+    let visitor = ScopeSnapshotVisitor { environment };
+    let blocks = function
+        .body
+        .blocks
+        .iter()
+        .map(|(_, block)| {
+            let instructions = block
+                .instructions
+                .iter()
+                .map(|instruction_id| {
+                    let instruction = &function.instructions[instruction_id.index()];
+                    let mut lvalues = vec![visitor.value_analysis(instruction.lvalue.identifier)];
+                    lvalues.extend(
+                        each_instruction_value_lvalue(&instruction.value)
+                            .into_iter()
+                            .map(|place| visitor.value_analysis(place.identifier)),
+                    );
+                    lvalues.sort_unstable_by_key(|value| value.id);
+                    lvalues.dedup_by_key(|value| value.id);
+                    let mut dependencies =
+                        each_instruction_value_operand(&instruction.value, environment)
+                            .into_iter()
+                            .map(|place| visitor.value_analysis(place.identifier))
+                            .collect::<Vec<_>>();
+                    dependencies.sort_unstable_by_key(|value| value.id);
+                    dependencies.dedup_by_key(|value| value.id);
+                    ControlFlowInstructionAnalysis {
+                        id: instruction.id.index(),
+                        kind: instruction_kind(&instruction.value),
+                        span: instruction.span.map(|span| (span.start, span.end)),
+                        lvalues,
+                        dependencies,
+                    }
+                })
+                .collect();
+            BlockAnalysis {
+                id: block.id.index(),
+                kind: block_kind(block.kind),
+                instructions,
+                terminal: terminal_analysis(&block.terminal, &visitor),
+            }
+        })
+        .collect();
+
+    ControlFlowAnalysis { entry: function.body.entry.index(), blocks }
+}
+
+pub(crate) fn capture_render_writes(
+    function: &HirFunction<'_>,
+    environment: &Environment<'_>,
+) -> Vec<WriteAnalysis> {
+    let visitor = ScopeSnapshotVisitor { environment };
+    function
+        .body
+        .blocks
+        .iter()
+        .flat_map(|(_, block)| &block.instructions)
+        .filter_map(|instruction_id| {
+            let instruction = &function.instructions[instruction_id.index()];
+            let (kind, targets) = match &instruction.value {
+                InstructionValue::StoreLocal { lvalue, .. } => {
+                    (WriteKindAnalysis::Local, vec![lvalue.place])
+                }
+                InstructionValue::StoreContext { lvalue, .. } => {
+                    (WriteKindAnalysis::Context, vec![lvalue.place])
+                }
+                InstructionValue::StoreGlobal { .. } => (WriteKindAnalysis::Global, Vec::new()),
+                InstructionValue::Destructure { .. } => (
+                    WriteKindAnalysis::Destructure,
+                    each_instruction_value_lvalue(&instruction.value).into_vec(),
+                ),
+                InstructionValue::PropertyStore { object, .. } => {
+                    (WriteKindAnalysis::Property, vec![*object])
+                }
+                InstructionValue::ComputedStore { object, .. } => {
+                    (WriteKindAnalysis::ComputedProperty, vec![*object])
+                }
+                InstructionValue::PropertyDelete { object, .. } => {
+                    (WriteKindAnalysis::DeleteProperty, vec![*object])
+                }
+                InstructionValue::ComputedDelete { object, .. } => {
+                    (WriteKindAnalysis::DeleteComputedProperty, vec![*object])
+                }
+                InstructionValue::PrefixUpdate { lvalue, .. } => {
+                    (WriteKindAnalysis::PrefixUpdate, vec![*lvalue])
+                }
+                InstructionValue::PostfixUpdate { lvalue, .. } => {
+                    (WriteKindAnalysis::PostfixUpdate, vec![*lvalue])
+                }
+                _ => return None,
+            };
+            Some(WriteAnalysis {
+                kind,
+                span: instruction.span.map(|span| (span.start, span.end)),
+                targets: targets
+                    .into_iter()
+                    .map(|place| visitor.value_analysis(place.identifier))
+                    .collect(),
+            })
+        })
+        .collect()
+}
+
+pub(crate) fn capture(
+    function: &ReactiveFunction<'_>,
+    environment: &Environment<'_>,
+    instructions: Vec<InstructionAnalysis>,
+    control_flow: ControlFlowAnalysis,
+    render_writes: Vec<WriteAnalysis>,
+) -> FunctionAnalysis {
+    let visitor = ScopeSnapshotVisitor { environment };
+    let mut state = SnapshotState::default();
+    visit_reactive_function(function, &visitor, &mut state);
+
+    FunctionAnalysis {
+        name: function.id.or(function.name_hint).map(|name| name.as_str().to_owned()),
+        span: function.span.map(|span| (span.start, span.end)),
+        control_flow,
+        render_writes,
+        scopes: state.scopes,
+        instructions,
+    }
+}
+
+pub(crate) fn capture_instructions(
+    function: &ReactiveFunction<'_>,
+    environment: &Environment<'_>,
+) -> Vec<InstructionAnalysis> {
+    let visitor = ScopeSnapshotVisitor { environment };
+    let mut state = SnapshotState::default();
+    visit_reactive_function(function, &visitor, &mut state);
+    state.instructions
+}
+
+#[derive(Default)]
+struct SnapshotState {
+    scopes: Vec<ScopeAnalysis>,
+    instructions: Vec<InstructionAnalysis>,
+}
+
+struct ScopeSnapshotVisitor<'env, 'arena> {
+    environment: &'env Environment<'arena>,
+}
+
+impl<'arena> ReactiveFunctionVisitor<'arena> for ScopeSnapshotVisitor<'_, 'arena> {
+    type State = SnapshotState;
+
+    fn env(&self) -> &Environment<'arena> {
+        self.environment
+    }
+
+    fn visit_scope(&self, block: &ReactiveScopeBlock<'arena>, state: &mut Self::State) {
+        let scope = &self.environment.scopes[block.scope];
+        let dependencies = scope
+            .dependencies
+            .iter()
+            .filter_map(|dependency| {
+                let identifier = &self.environment.identifiers[dependency.identifier];
+                let name = identifier.name?.value().to_owned();
+                Some(DependencyAnalysis {
+                    name,
+                    path: dependency.path.iter().map(|entry| entry.property.to_string()).collect(),
+                    reactive: dependency.reactive,
+                })
+            })
+            .collect();
+        let declarations = scope
+            .declarations
+            .iter()
+            .filter_map(|(_, declaration)| {
+                self.environment.identifiers[declaration.identifier]
+                    .name
+                    .map(|name| name.value().to_owned())
+            })
+            .collect();
+
+        state.scopes.push(ScopeAnalysis { dependencies, declarations });
+        self.traverse_scope(block, state);
+    }
+
+    fn visit_instruction(
+        &self,
+        instruction: &ReactiveInstruction<'arena>,
+        state: &mut Self::State,
+    ) {
+        let mut lvalues = instruction
+            .lvalue
+            .into_iter()
+            .map(|place| self.value_analysis(place.identifier))
+            .collect::<Vec<_>>();
+        if let ReactiveValue::Instruction(value) = &instruction.value {
+            lvalues.extend(
+                each_instruction_value_lvalue(value)
+                    .into_iter()
+                    .map(|place| self.value_analysis(place.identifier)),
+            );
+        }
+        lvalues.sort_unstable_by_key(|value| value.id);
+        lvalues.dedup_by_key(|value| value.id);
+        let mut dependencies = Vec::new();
+        self.collect_value_dependencies(&instruction.value, &mut dependencies);
+        dependencies.sort_unstable_by_key(|value| value.id);
+        dependencies.dedup_by_key(|value| value.id);
+        state.instructions.push(InstructionAnalysis { lvalues, dependencies });
+        self.traverse_instruction(instruction, state);
+    }
+}
+
+impl ScopeSnapshotVisitor<'_, '_> {
+    fn value_analysis(&self, identifier: crate::react_compiler_hir::IdentifierId) -> ValueAnalysis {
+        let identifier = &self.environment.identifiers[identifier];
+        ValueAnalysis {
+            id: identifier.id.index(),
+            declaration_id: identifier.declaration_id.index(),
+            name: identifier.name.map(|name| name.value().to_owned()),
+            span: identifier.span.map(|span| (span.start, span.end)),
+        }
+    }
+
+    fn collect_value_dependencies(
+        &self,
+        value: &ReactiveValue<'_>,
+        dependencies: &mut Vec<ValueAnalysis>,
+    ) {
+        match value {
+            ReactiveValue::Instruction(value) => dependencies.extend(
+                each_instruction_value_operand(value, self.environment)
+                    .into_iter()
+                    .map(|place| self.value_analysis(place.identifier)),
+            ),
+            ReactiveValue::LogicalExpression { left, right, .. } => {
+                self.collect_value_dependencies(left, dependencies);
+                self.collect_value_dependencies(right, dependencies);
+            }
+            ReactiveValue::ConditionalExpression { test, consequent, alternate } => {
+                self.collect_value_dependencies(test, dependencies);
+                self.collect_value_dependencies(consequent, dependencies);
+                self.collect_value_dependencies(alternate, dependencies);
+            }
+            ReactiveValue::SequenceExpression { instructions, value, .. } => {
+                for instruction in instructions {
+                    self.collect_value_dependencies(&instruction.value, dependencies);
+                }
+                self.collect_value_dependencies(value, dependencies);
+            }
+            ReactiveValue::OptionalExpression { value, .. } => {
+                self.collect_value_dependencies(value, dependencies);
+            }
+        }
+    }
+}
+
+fn block_kind(kind: BlockKind) -> BlockKindAnalysis {
+    match kind {
+        BlockKind::Block => BlockKindAnalysis::Block,
+        BlockKind::Value => BlockKindAnalysis::Value,
+        BlockKind::Loop => BlockKindAnalysis::Loop,
+        BlockKind::Sequence => BlockKindAnalysis::Sequence,
+        BlockKind::Catch => BlockKindAnalysis::Catch,
+    }
+}
+
+fn instruction_kind(value: &InstructionValue<'_>) -> InstructionKindAnalysis {
+    match value {
+        InstructionValue::LoadLocal { .. } => InstructionKindAnalysis::LoadLocal,
+        InstructionValue::LoadContext { .. } => InstructionKindAnalysis::LoadContext,
+        InstructionValue::DeclareLocal { .. } => InstructionKindAnalysis::DeclareLocal,
+        InstructionValue::DeclareContext { .. } => InstructionKindAnalysis::DeclareContext,
+        InstructionValue::StoreLocal { .. } => InstructionKindAnalysis::StoreLocal,
+        InstructionValue::StoreContext { .. } => InstructionKindAnalysis::StoreContext,
+        InstructionValue::Destructure { .. } => InstructionKindAnalysis::Destructure,
+        InstructionValue::Primitive { .. } => InstructionKindAnalysis::Primitive,
+        InstructionValue::JSXText { .. } => InstructionKindAnalysis::JsxText,
+        InstructionValue::BinaryExpression { .. } => InstructionKindAnalysis::BinaryExpression,
+        InstructionValue::NewExpression { .. } => InstructionKindAnalysis::NewExpression,
+        InstructionValue::CallExpression { .. } => InstructionKindAnalysis::CallExpression,
+        InstructionValue::MethodCall { .. } => InstructionKindAnalysis::MethodCall,
+        InstructionValue::UnaryExpression { .. } => InstructionKindAnalysis::UnaryExpression,
+        InstructionValue::TypeCastExpression { .. } => InstructionKindAnalysis::TypeCastExpression,
+        InstructionValue::JsxExpression { .. } => InstructionKindAnalysis::JsxExpression,
+        InstructionValue::ObjectExpression { .. } => InstructionKindAnalysis::ObjectExpression,
+        InstructionValue::ObjectMethod { .. } => InstructionKindAnalysis::ObjectMethod,
+        InstructionValue::ArrayExpression { .. } => InstructionKindAnalysis::ArrayExpression,
+        InstructionValue::JsxFragment { .. } => InstructionKindAnalysis::JsxFragment,
+        InstructionValue::RegExpLiteral { .. } => InstructionKindAnalysis::RegExpLiteral,
+        InstructionValue::MetaProperty { .. } => InstructionKindAnalysis::MetaProperty,
+        InstructionValue::PropertyStore { .. } => InstructionKindAnalysis::PropertyStore,
+        InstructionValue::PropertyLoad { .. } => InstructionKindAnalysis::PropertyLoad,
+        InstructionValue::PropertyDelete { .. } => InstructionKindAnalysis::PropertyDelete,
+        InstructionValue::ComputedStore { .. } => InstructionKindAnalysis::ComputedStore,
+        InstructionValue::ComputedLoad { .. } => InstructionKindAnalysis::ComputedLoad,
+        InstructionValue::ComputedDelete { .. } => InstructionKindAnalysis::ComputedDelete,
+        InstructionValue::LoadGlobal { .. } => InstructionKindAnalysis::LoadGlobal,
+        InstructionValue::StoreGlobal { .. } => InstructionKindAnalysis::StoreGlobal,
+        InstructionValue::FunctionExpression { .. } => InstructionKindAnalysis::FunctionExpression,
+        InstructionValue::TaggedTemplateExpression { .. } => {
+            InstructionKindAnalysis::TaggedTemplateExpression
+        }
+        InstructionValue::TemplateLiteral { .. } => InstructionKindAnalysis::TemplateLiteral,
+        InstructionValue::Await { .. } => InstructionKindAnalysis::Await,
+        InstructionValue::GetIterator { .. } => InstructionKindAnalysis::GetIterator,
+        InstructionValue::IteratorNext { .. } => InstructionKindAnalysis::IteratorNext,
+        InstructionValue::NextPropertyOf { .. } => InstructionKindAnalysis::NextPropertyOf,
+        InstructionValue::PrefixUpdate { .. } => InstructionKindAnalysis::PrefixUpdate,
+        InstructionValue::PostfixUpdate { .. } => InstructionKindAnalysis::PostfixUpdate,
+        InstructionValue::Debugger { .. } => InstructionKindAnalysis::Debugger,
+        InstructionValue::StartMemoize { .. } => InstructionKindAnalysis::StartMemoize,
+        InstructionValue::FinishMemoize { .. } => InstructionKindAnalysis::FinishMemoize,
+    }
+}
+
+fn terminal_analysis(
+    terminal: &Terminal<'_>,
+    visitor: &ScopeSnapshotVisitor<'_, '_>,
+) -> TerminalAnalysis {
+    let kind = match terminal {
+        Terminal::Unreachable { .. } => TerminalKindAnalysis::Unreachable,
+        Terminal::Throw { .. } => TerminalKindAnalysis::Throw,
+        Terminal::Return { return_variant, .. } => {
+            TerminalKindAnalysis::Return(match return_variant {
+                ReturnVariant::Void => ReturnVariantAnalysis::Void,
+                ReturnVariant::Implicit => ReturnVariantAnalysis::Implicit,
+                ReturnVariant::Explicit => ReturnVariantAnalysis::Explicit,
+            })
+        }
+        Terminal::Goto { variant, .. } => TerminalKindAnalysis::Goto(match variant {
+            GotoVariant::Break => GotoVariantAnalysis::Break,
+            GotoVariant::Continue => GotoVariantAnalysis::Continue,
+            GotoVariant::Try => GotoVariantAnalysis::Try,
+        }),
+        Terminal::If { .. } => TerminalKindAnalysis::If,
+        Terminal::Branch { .. } => TerminalKindAnalysis::Branch,
+        Terminal::Switch { .. } => TerminalKindAnalysis::Switch,
+        Terminal::DoWhile { .. } => TerminalKindAnalysis::DoWhile,
+        Terminal::While { .. } => TerminalKindAnalysis::While,
+        Terminal::For { .. } => TerminalKindAnalysis::For,
+        Terminal::ForOf { .. } => TerminalKindAnalysis::ForOf,
+        Terminal::ForIn { .. } => TerminalKindAnalysis::ForIn,
+        Terminal::Logical { .. } => TerminalKindAnalysis::Logical,
+        Terminal::Ternary { .. } => TerminalKindAnalysis::Ternary,
+        Terminal::Optional { .. } => TerminalKindAnalysis::Optional,
+        Terminal::Label { .. } => TerminalKindAnalysis::Label,
+        Terminal::Sequence { .. } => TerminalKindAnalysis::Sequence,
+        Terminal::MaybeThrow { .. } => TerminalKindAnalysis::MaybeThrow,
+        Terminal::Try { .. } => TerminalKindAnalysis::Try,
+        Terminal::Scope { .. } => TerminalKindAnalysis::Scope,
+        Terminal::PrunedScope { .. } => TerminalKindAnalysis::PrunedScope,
+    };
+    let operands = match terminal {
+        Terminal::Throw { value, .. } | Terminal::Return { value, .. } => {
+            vec![visitor.value_analysis(value.identifier)]
+        }
+        Terminal::If { test, .. }
+        | Terminal::Branch { test, .. }
+        | Terminal::Switch { test, .. } => {
+            let mut values = vec![visitor.value_analysis(test.identifier)];
+            if let Terminal::Switch { cases, .. } = terminal {
+                values.extend(
+                    cases
+                        .iter()
+                        .filter_map(|case| case.test)
+                        .map(|place| visitor.value_analysis(place.identifier)),
+                );
+            }
+            values
+        }
+        Terminal::Try { handler_binding, .. } => {
+            handler_binding.iter().map(|place| visitor.value_analysis(place.identifier)).collect()
+        }
+        _ => Vec::new(),
+    };
+    let successors = match terminal {
+        Terminal::Unreachable { .. } | Terminal::Throw { .. } | Terminal::Return { .. } => {
+            Vec::new()
+        }
+        Terminal::Goto { block, .. } => vec![block.index()],
+        Terminal::If { consequent, alternate, fallthrough, .. }
+        | Terminal::Branch { consequent, alternate, fallthrough, .. } => {
+            vec![consequent.index(), alternate.index(), fallthrough.index()]
+        }
+        Terminal::Switch { cases, fallthrough, .. } => {
+            cases.iter().map(|case| case.block.index()).chain([fallthrough.index()]).collect()
+        }
+        Terminal::DoWhile { loop_block, test, fallthrough, .. } => {
+            vec![loop_block.index(), test.index(), fallthrough.index()]
+        }
+        Terminal::While { test, loop_block, fallthrough, .. } => {
+            vec![test.index(), loop_block.index(), fallthrough.index()]
+        }
+        Terminal::For { init, test, update, loop_block, fallthrough, .. } => [
+            Some(init.index()),
+            Some(test.index()),
+            update.map(|block| block.index()),
+            Some(loop_block.index()),
+            Some(fallthrough.index()),
+        ]
+        .into_iter()
+        .flatten()
+        .collect(),
+        Terminal::ForOf { init, test, loop_block, fallthrough, .. } => {
+            vec![init.index(), test.index(), loop_block.index(), fallthrough.index()]
+        }
+        Terminal::ForIn { init, loop_block, fallthrough, .. } => {
+            vec![init.index(), loop_block.index(), fallthrough.index()]
+        }
+        Terminal::Logical { test, fallthrough, .. }
+        | Terminal::Ternary { test, fallthrough, .. }
+        | Terminal::Optional { test, fallthrough, .. } => {
+            vec![test.index(), fallthrough.index()]
+        }
+        Terminal::Label { block, fallthrough, .. }
+        | Terminal::Sequence { block, fallthrough, .. }
+        | Terminal::Scope { block, fallthrough, .. }
+        | Terminal::PrunedScope { block, fallthrough, .. } => {
+            vec![block.index(), fallthrough.index()]
+        }
+        Terminal::MaybeThrow { continuation, handler, .. } => {
+            [Some(continuation.index()), handler.map(|block| block.index())]
+                .into_iter()
+                .flatten()
+                .collect()
+        }
+        Terminal::Try { block, handler, fallthrough, .. } => {
+            vec![block.index(), handler.index(), fallthrough.index()]
+        }
+    };
+
+    TerminalAnalysis {
+        id: terminal.evaluation_order().index(),
+        kind,
+        span: terminal.span().map(|span| (span.start, span.end)),
+        operands,
+        successors,
+    }
+}
