{
  "name": "vidact",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm test",
    "format:rust": "cargo fmt -p vidact-compiler --check",
    "test": "pnpm test:rust && pnpm test:browser",
    "test:browser": "pnpm --filter @vidact/browser-corpus test",
    "test:rust": "cargo test --workspace",
    "typecheck": "pnpm --recursive typecheck"
  },
  "engines": {
    "node": ">=24"
  }
}
