{
  "name": "vidact",
  "private": true,
  "type": "module",
  "scripts": {
    "build:examples": "pnpm --filter @vidact/example-todomvc build",
    "build:packages": "pnpm --filter @vidact/runtime build && pnpm --filter @vidact/test-support build && pnpm --filter @vidact/vite build",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "dev:todomvc": "pnpm --filter @vidact/example-todomvc dev",
    "format": "oxfmt --disable-nested-config \"**/*.{js,jsx,ts,tsx,json,jsonc,css}\" --check",
    "format:fix": "oxfmt --disable-nested-config \"**/*.{js,jsx,ts,tsx,json,jsonc,css}\" --write",
    "format:rust": "cargo fmt -p vidact-compiler --check",
    "lint": "oxlint --disable-nested-config . && ast-grep scan --globs '!vendor/**'",
    "lint:fix": "oxlint . --fix",
    "size": "pnpm --fail-if-no-match --filter @vidact/runtime-size measure",
    "test": "pnpm build:packages && pnpm test:rust && pnpm test:runtime && pnpm test:tools && pnpm test:browser && pnpm test:examples && pnpm test:packages",
    "test:browser": "pnpm --filter @vidact/browser-corpus test",
    "test:examples": "pnpm --filter @vidact/example-todomvc test",
    "test:packages": "node scripts/verify-packages.mjs",
    "test:runtime": "pnpm --filter @vidact/runtime test",
    "test:rust": "cargo test --workspace",
    "test:tools": "pnpm --filter @vidact/vite test",
    "typecheck": "pnpm build:packages && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.19.0"
}
